# Local development: npm run dev, browser http://127.0.0.1:5173.
# Production/Docker: browser http://127.0.0.1:3000.
# Leave APP_ORIGIN unset to use the appropriate default.
# APP_ORIGIN=http://127.0.0.1:5173

HOST=127.0.0.1
PORT=3000

# Set production for npm start after npm run build. Docker sets this itself.
# NODE_ENV=production

# Synthetic data only; no Steam connection in demo mode.
DEMO_MODE=false

# Comma-separated SteamID64 values. Required for a non-loopback APP_ORIGIN.
# ALLOWED_STEAM_IDS=76561198000000000
ALLOWED_STEAM_IDS=

# Inactivity timeout. Ending a session disconnects its Steam client.
SESSION_TTL_MINUTES=60

# Optional HTTP(S) proxy for Steam QR authentication and CM connection only.
# Standard HTTPS_PROXY / HTTP_PROXY are used as a fallback.
# Cloud file downloads require direct HTTPS access to Steam storage.
# STEAM_HTTP_PROXY=http://127.0.0.1:7890
