# Optional local settings. Never put Steam credentials or tokens here.
HOST=127.0.0.1
PORT=3000
DEMO_MODE=false
SESSION_TTL_MINUTES=60
# Development defaults to http://127.0.0.1:5173; npm start sets the local production origin.
# APP_ORIGIN=http://127.0.0.1:5173
# Optional trusted outbound proxy for Steam CM/auth. Storage downloads use pinned HTTPS directly.
# STEAM_HTTP_PROXY=http://127.0.0.1:7890
# Public-site build only; no account data. Use the actual production origin, not a placeholder.
# SITE_URL=https://your-project.vercel.app
